# Database
POSTGRES_IMAGE=postgres:15.14-alpine3.22
POSTGRES_DB=db-name
POSTGRES_USER=user_db
POSTGRES_PASSWORD=db-password

# Redis
REDIS_IMAGE=redis:8.2.3-alpine

# MinIO
MINIO_IMAGE=minio/minio:latest
MINIO_ROOT_USER=minio-user
MINIO_ROOT_PASSWORD=minio-pass
MINIO_BUCKET=service-evidence

# Nginx
NGINX_IMAGE=nginx:1.28.0-alpine

# SonarQube
SONAR_IMAGE=sonarqube:2025.5.0-developer
SONAR_JDBC_USERNAME=sonar-user
SONAR_JDBC_PASSWORD=sonar-pass

# Docker image (push)
DOCKER_REPO=morthagor/aiimage

# App
SPRING_PROFILES_ACTIVE=docker

# Retention policy (years)
IMAGE_RETENTION_YEARS=5
