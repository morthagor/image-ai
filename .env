# Database
POSTGRES_IMAGE=postgres:16.10-alpine
POSTGRES_DB=aiimage
POSTGRES_USER=aiimage
POSTGRES_PASSWORD=aiimage

# Redis
REDIS_IMAGE=redis:7.2-alpine

# MinIO
MINIO_IMAGE=minio/minio:latest
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=service-evidence

# Nginx
NGINX_IMAGE=nginx:1.25-alpine

# SonarQube
SONAR_IMAGE=sonarqube:lts-community
SONAR_JDBC_USERNAME=sonar
SONAR_JDBC_PASSWORD=sonar

# Docker image (push)
DOCKER_REPO=morthagor/aiimage

# App
SPRING_PROFILES_ACTIVE=docker

# Retention policy (years)
IMAGE_RETENTION_YEARS=5
